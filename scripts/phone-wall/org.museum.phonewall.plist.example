<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.museum.phonewall</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>/ABSOLUTE/PROJECT/scripts/phone-wall/run-server.sh</string></array>
<key>EnvironmentVariables</key><dict>
<key>PHONE_WALL_ROOT</key><string>/ABSOLUTE/PROJECT</string>
<key>NODE_BINARY</key><string>/ABSOLUTE/node</string>
<key>PHONE_WALL_ADMIN_TOKEN</key><string>REPLACE_WITH_RANDOM_64_HEX</string>
<key>PHONE_WALL_DATA_DIR</key><string>/ABSOLUTE/persistent-data</string>
<key>PHONE_WALL_LOG_DIR</key><string>/ABSOLUTE/logs</string>
</dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>StandardOutPath</key><string>/ABSOLUTE/logs/phonewall.log</string>
<key>StandardErrorPath</key><string>/ABSOLUTE/logs/phonewall-error.log</string>
</dict></plist>
