#!/bin/bash
set -euo pipefail
ROOT='/Library/Application Support/PhoneWall'
APP="$ROOT/app"
GROUP='_phonewall'
USER='_phonewall'
if ! /usr/bin/dscl . -read "/Groups/$GROUP" PrimaryGroupID >/dev/null 2>&1; then
  for CANDIDATE in $(/usr/bin/seq 499 -1 400); do
    if [ -z "$(/usr/bin/dscl . -search /Groups PrimaryGroupID "$CANDIDATE")" ]; then
      /usr/bin/dscl . -create "/Groups/$GROUP"
      /usr/bin/dscl . -create "/Groups/$GROUP" PrimaryGroupID "$CANDIDATE"
      break
    fi
  done
fi
GID="$(/usr/bin/dscl . -read "/Groups/$GROUP" PrimaryGroupID | /usr/bin/awk '{print $2}')"
if ! /usr/bin/dscl . -read "/Users/$USER" UniqueID >/dev/null 2>&1; then
  for CANDIDATE in $(/usr/bin/seq 499 -1 400); do
    if [ -z "$(/usr/bin/dscl . -search /Users UniqueID "$CANDIDATE")" ]; then
      /usr/bin/dscl . -create "/Users/$USER"
      /usr/bin/dscl . -create "/Users/$USER" UniqueID "$CANDIDATE"
      /usr/bin/dscl . -create "/Users/$USER" PrimaryGroupID "$GID"
      /usr/bin/dscl . -create "/Users/$USER" RealName 'Phone Wall Controller'
      /usr/bin/dscl . -create "/Users/$USER" UserShell /usr/bin/false
      /usr/bin/dscl . -create "/Users/$USER" NFSHomeDirectory /var/empty
      /usr/bin/dscl . -create "/Users/$USER" IsHidden 1
      /usr/bin/dscl . -create "/Users/$USER" Password '*'
      break
    fi
  done
fi
UID_VALUE="$(/usr/bin/dscl . -read "/Users/$USER" UniqueID | /usr/bin/awk '{print $2}')"
if ! [[ "$UID_VALUE" =~ ^[1-9][0-9]*$ && "$GID" =~ ^[1-9][0-9]*$ ]]; then
  echo 'Invalid Phone Wall service account' >&2
  exit 1
fi
"$APP/runtime/bin/node" "$APP/scripts/phone-wall/installer/configure.mjs"
/bin/mkdir -p "$ROOT/data" /Library/Logs/PhoneWall
/usr/sbin/chown "$UID_VALUE:$GID" "$ROOT/data"
/bin/chmod 700 "$ROOT/data"
# Local museum staff can launch the dashboard; the key is never served by HTTP.
/usr/sbin/chown "$UID_VALUE:staff" "$ROOT/operator.key" /Library/Logs/PhoneWall
/bin/chmod 640 "$ROOT/operator.key"
/bin/chmod 750 /Library/Logs/PhoneWall
/usr/sbin/chown root:wheel /Library/LaunchDaemons/org.museum.phonewall.plist
/usr/bin/plutil -lint /Library/LaunchDaemons/org.museum.phonewall.plist
/bin/launchctl bootstrap system /Library/LaunchDaemons/org.museum.phonewall.plist
PORT="$(/usr/bin/plutil -extract port raw "$ROOT/config.json")"
for ATTEMPT in $(/usr/bin/seq 1 30); do
  if /usr/bin/curl --silent --fail --max-time 1 "http://127.0.0.1:$PORT/health" >/dev/null; then
    echo 'Phone Wall is running. Open Phone Wall Dashboard from Applications.'
    exit 0
  fi
  /bin/sleep 1
done
echo 'Phone Wall was installed but has not passed its startup check. See /Library/Logs/PhoneWall/server.log.' >&2
exit 1
