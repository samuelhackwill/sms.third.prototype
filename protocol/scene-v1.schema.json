{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phone-wall:artwork-scene:1",
  "title": "Phone Wall declarative artwork scene v1",
  "type": "object",
  "required": [
    "sceneSchemaVersion",
    "artworkId",
    "artworkVersion",
    "canvas",
    "background",
    "transition",
    "elements"
  ],
  "properties": {
    "sceneSchemaVersion": { "const": 1 },
    "artworkId": { "type": "string", "pattern": "^[-\\w]{1,80}$" },
    "artworkVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 1, "maximum": 100000 },
        "height": { "type": "number", "minimum": 1, "maximum": 100000 }
      }
    },
    "background": { "$ref": "#/$defs/color" },
    "parameters": { "type": "object" },
    "transition": {
      "type": "object",
      "required": ["type", "durationMs"],
      "properties": {
        "type": { "enum": ["cut", "fade"] },
        "durationMs": { "type": "number", "minimum": 0, "maximum": 5000 }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/element" }
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["name", "hash"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[-\\w]+\\.(png|jpg|mp4|js)$",
            "not": { "enum": ["art.js", "pixi.js"] }
          },
          "hash": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frame": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "y": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "width": { "type": "number", "minimum": 1, "maximum": 100000 },
        "height": { "type": "number", "minimum": 1, "maximum": 100000 }
      }
    },
    "animation": {
      "type": "object",
      "required": ["property", "from", "to", "durationMs", "repeat", "easing"],
      "properties": {
        "property": { "enum": ["x", "y", "opacity", "rotation"] },
        "from": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "to": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "durationMs": { "type": "number", "minimum": 16, "maximum": 3600000 },
        "delayMs": { "type": "number", "minimum": 0, "maximum": 3600000 },
        "repeat": { "type": "boolean" },
        "easing": { "enum": ["linear", "easeInOut"] }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "type", "frame"],
      "properties": {
        "id": { "type": "string", "pattern": "^[-\\w]{1,60}$" },
        "type": { "enum": ["text", "rect", "ticker", "image", "video", "web"] },
        "frame": { "$ref": "#/$defs/frame" },
        "text": { "type": "string", "maxLength": 2000 },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 300 },
        "speed": { "type": "number", "minimum": 0, "maximum": 10000 },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number", "minimum": -3600, "maximum": 3600 },
        "asset": { "$ref": "#/$defs/hash" },
        "animation": { "$ref": "#/$defs/animation" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["text", "ticker"] } } },
          "then": { "required": ["text", "fontSize"] }
        },
        {
          "if": { "properties": { "type": { "const": "ticker" } } },
          "then": { "required": ["speed"] }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["image", "video", "web"] } }
          },
          "then": { "required": ["asset"] }
        }
      ]
    }
  }
}
